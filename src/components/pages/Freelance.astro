---
import Layout from "@/layouts/Layout.astro";
import { useTranslations, localizeHref, type Lang } from "@/i18n/ui";
import { CONFIG } from "@/data/config";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const fp = t.freelancePage;
const email = "contact.SPADRAO@proton.me";

// Projets liés par prestation (mêmes pour les 4 langues : noms neutres + slugs).
// L'ordre suit celui de fp.services : 0 cadrage, 1 design carte, 2 revue & expertise, 3 sourcing, 4 industrialisation.
const P = {
  ep6000: "/projects/ep6000-une-interpretation-moderne-de-la-mesure-de-la-qualite-de-l-air",
  zaack: "/projects/zaack-dust-v2-une-evolution-vers-la-modernite",
  carmat: "/projects/carmat-quand-on-comprends-enfin-l-impact-de-la-tech-dans-la-vie-des-gens",
  springcard: "/projects/springcard-de-la-soudure-de-prototypes-a-l-antenne-du-produit-phare",
  nanosense: "/projects/nanosense-histoire-d-une-reprise-d-une-industrialisation-en-chine",
  hermes: "/projects/hermes-x-kickmaker-quand-le-luxe-rencontre-la-tech",
  elax: "/projects/elax-x-kickmaker-le-debut-d-une-habitation-controle-et-ecologique",
  javelot: "/projects/javelot-x-kickmaker-un-premier-pas-vers-l-agriculture-connecte",
};
const serviceCases: { name: string; href: string }[][] = [
  // 0 — Cahier des charges & cadrage
  [
    { name: "EP6000", href: P.ep6000 },
    { name: "Javelot", href: P.javelot },
    { name: "Zaack DUST V2", href: P.zaack },
  ],
  // 1 — Design de carte électronique
  [
    { name: "EP6000", href: P.ep6000 },
    { name: "Zaack DUST V2", href: P.zaack },
    { name: "Carmat", href: P.carmat },
    { name: "SpringCard", href: P.springcard },
  ],
  // 2 — Revue & expertise
  [
    { name: "Zaack DUST V2", href: P.zaack },
    { name: "Carmat", href: P.carmat },
    { name: "EP6000", href: P.ep6000 },
    { name: "SpringCard", href: P.springcard },
  ],
  // 3 — Sourcing & obsolescence
  [
    { name: "Zaack DUST V2", href: P.zaack },
    { name: "NanoSense", href: P.nanosense },
    { name: "SpringCard", href: P.springcard },
  ],
  // 4 — Conseil en industrialisation
  [
    { name: "NanoSense", href: P.nanosense },
    { name: "Hermès", href: P.hermes },
    { name: "Elax", href: P.elax },
    { name: "SpringCard", href: P.springcard },
    { name: "EP6000", href: P.ep6000 },
    { name: "Zaack DUST V2", href: P.zaack },
  ],
];

// Icônes par prestation (SVG inline, même ordre que fp.services).
const icons = [
  "M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z",
  "M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 0 0 2.25-2.25V6.75a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 6.75v10.5a2.25 2.25 0 0 0 2.25 2.25Zm.75-12h9v9h-9v-9Z",
  "m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z",
  "m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9",
  "M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21",
];

// JSON-LD : signale explicitement une offre de prestations (provider = la personne).
const serviceLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: fp.metaTitle,
  description: fp.metaDescription,
  url: `${CONFIG.site.url}${localizeHref("/freelance", lang)}`,
  areaServed: ["France", "Europe"],
  serviceType: fp.services.map((s) => s.title),
  provider: {
    "@type": "Person",
    name: "Stéphane Padrao",
    url: CONFIG.site.url,
  },
};
---

<Layout title={fp.metaTitle} description={fp.metaDescription} lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} is:inline />
  <div class="mx-auto flex max-w-3xl flex-col gap-10">

    <div class="flex flex-col gap-3">
      <h1 class="text-3xl font-semibold tracking-tighter sm:text-4xl">{fp.h1}</h1>
      <p class="text-pretty text-muted-foreground">{fp.intro}</p>
      <a
        href={localizeHref("/contact", lang)}
        class="mt-1 inline-flex w-fit items-center rounded-lg border border-border bg-background px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted"
      >
        {fp.cta}
      </a>
    </div>

    <div class="flex flex-col gap-4">
      {fp.services.map((s, i) => (
        <div class="flex gap-4 rounded-xl border bg-background p-5 ring-2 ring-border/20">
          <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={icons[i]} />
            </svg>
          </span>
          <div class="flex flex-col gap-3">
            <h2 class="text-lg font-semibold">{s.title}</h2>
            <p class="text-pretty text-sm text-muted-foreground">{s.text}</p>
            <div class="flex flex-wrap items-center gap-1.5">
              <span class="mr-1 text-xs text-muted-foreground">{fp.relatedLabel} :</span>
              {(serviceCases[i] ?? []).map((c) => (
                <a
                  href={localizeHref(c.href, lang)}
                  class="rounded-md border bg-background px-2 py-0.5 text-xs font-medium text-foreground ring-1 ring-border/20 transition-colors hover:text-primary hover:ring-primary/40"
                >
                  {c.name}
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="flex flex-col gap-6 rounded-2xl border border-border bg-card p-6 sm:p-8 shadow-sm">
      <div class="flex flex-col gap-1.5">
        <h2 class="text-balance text-xl font-semibold text-foreground tracking-tight">{fp.ctaIntro}</h2>
        <p class="text-sm text-muted-foreground">{fp.reassurance}</p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <a
          href="https://calendly.com/stephanepadrao/30min"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90 shadow-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          {fp.calendlyCta}
        </a>
        <a
          href={localizeHref("/contact", lang)}
          class="inline-flex items-center justify-center rounded-xl border border-border bg-background px-5 py-3 text-sm font-medium text-foreground transition-colors hover:bg-accent"
        >
          {fp.cta}
        </a>
      </div>

      <!-- Secondary Links -->
      <div class="pt-4 border-t border-border/40 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs sm:text-sm text-muted-foreground">
        <a
          href={`mailto:${email}`}
          class="font-medium text-foreground hover:text-primary transition-colors underline-offset-4 hover:underline"
        >
          {email}
        </a>
        <span class="text-border">•</span>
        <a
          href="https://linkedin.com/in/SPADRAO"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-foreground hover:text-primary transition-colors underline-offset-4 hover:underline"
        >
          LinkedIn
        </a>
        <span class="text-border">•</span>
        <a
          href={localizeHref("/cv", lang)}
          class="font-medium text-foreground hover:text-primary transition-colors underline-offset-4 hover:underline"
        >
          {t.cvPage.linkLabel}
        </a>
      </div>
    </div>

  </div>
</Layout>
