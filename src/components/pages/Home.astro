---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import HomePage from "@/components/HomePage";
import { buildData } from "@/data/resume";
import { entriesForLang } from "@/i18n/content";
import type { Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const DATA = buildData(lang);
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: DATA.name,
  url: DATA.url,
  image: `${DATA.url}${DATA.avatarUrl}`,
  description: DATA.description,
  jobTitle: lang === "en" ? "Product Manager & Tech Maker" : "Responsable Produit & Maker Tech",
  knowsAbout: [
    "Conception électronique",
    "Conception de carte électronique (PCB)",
    "Industrialisation produit",
    "Sourcing électronique Chine et Europe",
    "Marquage CE",
    "Firmware embarqué",
    "LoRa",
    "Product management hardware",
  ],
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Polytech Sorbonne" },
    { "@type": "CollegeOrUniversity", name: "IAE Paris, Sorbonne Business School" },
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Le Plessis-Robinson",
    addressRegion: "Île-de-France",
    addressCountry: "FR",
  },
  sameAs: ["https://github.com/StephanePadrao", "https://linkedin.com/in/SPADRAO"],
};

const localized = entriesForLang(await getCollection("projects"), lang);
const projects = localized
  .sort((a, b) => {
    const ya = parseInt(a.entry.data.dates.match(/\d{4}/)?.[0] ?? "0");
    const yb = parseInt(b.entry.data.dates.match(/\d{4}/)?.[0] ?? "0");
    return yb - ya;
  })
  .map(({ slug, entry }) => ({
    id: slug, // slug de base → ProjectsSection préfixe la locale dans le href
    title: entry.data.title,
    dates: entry.data.dates,
    active: entry.data.active,
    description: entry.data.description,
    technologies: entry.data.technologies,
    links: entry.data.links,
    cover: entry.data.cover,
  }));
---

<Layout lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify(personLd)} is:inline />
  <HomePage client:load projects={projects} locale={lang} />
</Layout>
