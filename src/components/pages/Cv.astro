---
import Layout from "@/layouts/Layout.astro";
import { useTranslations, languages, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = t.cvPage;

// Un CV par langue. Le viewer s'ouvre par défaut sur la langue de la page.
const PDF: Record<Lang, string> = {
  fr: "/cv/cv-stephane-padrao-fr.pdf",
  en: "/cv/cv-stephane-padrao-en.pdf",
  es: "/cv/cv-stephane-padrao-es.pdf",
  pt: "/cv/cv-stephane-padrao-pt.pdf",
};
const DOWNLOAD_NAME: Record<Lang, string> = {
  fr: "CV-Stephane-Padrao-FR.pdf",
  en: "Stephane-Padrao-Resume-EN.pdf",
  es: "CV-Stephane-Padrao-ES.pdf",
  pt: "CV-Stephane-Padrao-PT.pdf",
};

const defaultCv: Lang = lang;
const tabs = Object.keys(languages) as Lang[];
---

<Layout title={c.metaTitle} description={c.metaDescription} lang={lang}>
  <div class="mx-auto flex max-w-4xl flex-col gap-6">

    <div class="flex flex-col gap-3">
      <h1 class="text-3xl font-semibold tracking-tighter sm:text-4xl">{c.h1}</h1>
      <p class="text-pretty text-muted-foreground">{c.intro}</p>
    </div>

    <div
      id="cv"
      data-fr={PDF.fr}
      data-en={PDF.en}
      data-es={PDF.es}
      data-pt={PDF.pt}
      class="flex flex-col gap-4"
    >

      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="inline-flex flex-wrap gap-0.5 self-start rounded-lg border border-border bg-muted/40 p-0.5" role="tablist">
          {tabs.map((code) => {
            const active = code === defaultCv;
            return (
              <button
                type="button"
                data-cv-lang={code}
                role="tab"
                aria-selected={active ? "true" : "false"}
                class:list={[
                  "cv-tab rounded-md px-3 py-1 text-sm font-medium transition-colors",
                  active ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground",
                ]}
              >
                {languages[code]}
              </button>
            );
          })}
        </div>

        <div class="flex flex-wrap gap-2">
          <a
            id="cv-download"
            href={PDF[defaultCv]}
            download={DOWNLOAD_NAME[defaultCv]}
            class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90"
          >
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
            </svg>
            {c.download}
          </a>

          <a
            id="cv-open"
            href={PDF[defaultCv]}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden items-center rounded-lg border border-border bg-background px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted md:inline-flex"
          >
            {c.openInNewTab}
          </a>
        </div>
      </div>

      {/* Viewer inline — desktop uniquement : les navigateurs mobiles ne rendent pas les PDF en iframe */}
      <div class="hidden overflow-hidden rounded-xl border border-border bg-muted/30 md:block">
        <iframe
          id="cv-frame"
          src={PDF[defaultCv]}
          title={c.h1}
          class="h-[80vh] w-full"
          loading="lazy"
        ></iframe>
      </div>

      {/* Fallback mobile — grande zone tappable qui ouvre le PDF en plein écran */}
      <a
        id="cv-open-mobile"
        href={PDF[defaultCv]}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-4 rounded-xl border border-border bg-muted/30 p-5 transition-colors hover:bg-muted md:hidden"
      >
        <svg class="size-9 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
        </svg>
        <span class="flex flex-col">
          <span class="font-medium text-foreground">{c.h1} · PDF</span>
          <span class="text-sm text-muted-foreground">{c.openInNewTab}</span>
        </span>
      </a>
    </div>
  </div>

  <script is:inline>
    (function () {
      var root = document.getElementById("cv");
      if (!root) return;
      var frame = document.getElementById("cv-frame");
      var dl = document.getElementById("cv-download");
      var open = document.getElementById("cv-open");
      var openMobile = document.getElementById("cv-open-mobile");
      var sources = {
        fr: root.getAttribute("data-fr"),
        en: root.getAttribute("data-en"),
        es: root.getAttribute("data-es"),
        pt: root.getAttribute("data-pt"),
      };
      var names = {
        fr: "CV-Stephane-Padrao-FR.pdf",
        en: "Stephane-Padrao-Resume-EN.pdf",
        es: "CV-Stephane-Padrao-ES.pdf",
        pt: "CV-Stephane-Padrao-PT.pdf",
      };
      var tabs = root.querySelectorAll("[data-cv-lang]");

      function select(l) {
        var src = sources[l];
        if (!src) return;
        if (frame) frame.src = src;
        dl.href = src;
        dl.setAttribute("download", names[l]);
        open.href = src;
        if (openMobile) openMobile.href = src;
        tabs.forEach(function (tab) {
          var on = tab.getAttribute("data-cv-lang") === l;
          tab.setAttribute("aria-selected", on ? "true" : "false");
          tab.classList.toggle("bg-background", on);
          tab.classList.toggle("text-foreground", on);
          tab.classList.toggle("shadow-sm", on);
          tab.classList.toggle("text-muted-foreground", !on);
        });
      }

      tabs.forEach(function (tab) {
        tab.addEventListener("click", function () {
          select(tab.getAttribute("data-cv-lang"));
        });
      });
    })();
  </script>
</Layout>
