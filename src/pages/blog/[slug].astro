---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { DATA } from "@/data/resume";
import { formatDate } from "@/lib/utils";
import { mdxComponents } from "@/mdx-components";
import { ChevronLeft, ChevronRight } from "lucide-react";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const sortedPosts = [...posts].filter((p) => !p.data.draft).sort((a, b) => {
    if (new Date(a.data.publishedAt) > new Date(b.data.publishedAt)) return -1;
    return 1;
  });
  return sortedPosts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      previousPost: index > 0 ? sortedPosts[index - 1] : null,
      nextPost: index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null,
    },
  }));
}

const { post, previousPost, nextPost } = Astro.props;
const { title, publishedAt, summary, image } = post.data;
const slug = post.id;

const { Content } = await render(post);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  datePublished: publishedAt,
  dateModified: publishedAt,
  description: summary,
  image: image
    ? image.startsWith("http")
      ? image
      : `${DATA.url}${image}`
    : `${DATA.url}/og_image.png`,
  url: `${DATA.url}/blog/${slug}`,
  author: {
    "@type": "Person",
    name: DATA.name,
  },
}).replace(/</g, "\\u003c");
---

<Layout
  title={title}
  description={summary}
  image={image}
  canonicalURL={`${DATA.url}/blog/${slug}`}
>
  <section id="blog">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <div class="flex justify-start gap-4 items-center">
      <a
        href="/blog"
        class="text-sm text-muted-foreground hover:text-foreground transition-colors border border-border rounded-lg px-2 py-1 inline-flex items-center gap-1 mb-6 group"
        aria-label="Retour au blog"
      >
        <ChevronLeft
          className="size-3 group-hover:-translate-x-px transition-transform"
        />
        Tous les articles
      </a>
    </div>
    <div class="flex flex-col gap-4">
      <h1
        class="title font-semibold text-3xl md:text-4xl tracking-tighter leading-tight"
      >
        {title}
      </h1>
      <p class="text-sm text-muted-foreground">
        {formatDate(publishedAt)}
      </p>
    </div>
    <div class="my-6 flex w-full items-center">
      <div
        class="flex-1 h-px bg-border"
        style="mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);"
      >
      </div>
    </div>
    {image && (
      <img
        src={image}
        alt={title}
        class="w-full rounded-xl object-cover max-h-[420px] mb-8 shadow-sm"
      />
    )}
    <article
      class="prose max-w-full text-pretty font-sans leading-relaxed text-muted-foreground dark:prose-invert"
    >
      <Content components={mdxComponents} />
    </article>

    <nav class="mt-16 pt-8 border-t border-border">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          previousPost ? (
            <a
              href={`/blog/${previousPost.id}`}
              class="group flex flex-col gap-2 p-5 rounded-xl border border-border hover:bg-accent/50 hover:border-primary/40 transition-all"
            >
              <span class="flex items-center gap-1.5 text-xs text-muted-foreground font-medium uppercase tracking-wide">
                <ChevronLeft className="size-3.5 shrink-0" />
                Article précédent
              </span>
              <span class="text-sm font-medium text-foreground/80 group-hover:text-foreground transition-colors line-clamp-2">
                {previousPost.data.title}
              </span>
            </a>
          ) : (
            <div />
          )
        }

        {
          nextPost ? (
            <a
              href={`/blog/${nextPost.id}`}
              class="group flex flex-col gap-2 p-5 rounded-xl border border-border hover:bg-accent/50 hover:border-primary/40 transition-all text-right"
            >
              <span class="flex items-center justify-end gap-1.5 text-xs text-muted-foreground font-medium uppercase tracking-wide">
                Article suivant
                <ChevronRight className="size-3.5 shrink-0" />
              </span>
              <span class="text-sm font-medium text-foreground/80 group-hover:text-foreground transition-colors line-clamp-2">
                {nextPost.data.title}
              </span>
            </a>
          ) : (
            <div />
          )
        }
      </div>
    </nav>
  </section>
</Layout>
