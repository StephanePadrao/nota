---
import "../styles/global.css";
import { buildData } from "@/data/resume";
import { CONFIG } from "@/data/config";
import { defaultLang, localizeHref, localeUrl, stripLangPrefix, useTranslations, languages, localeOg, type Lang } from "@/i18n/ui";
import { DiagonalGrid } from "@/components/magicui/diagonal-grid";
import Lightbox from "@/components/Lightbox.astro";

const year = new Date().getFullYear();

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  lang?: Lang;
}

const lang: Lang = Astro.props.lang ?? defaultLang;
const DATA = buildData(lang);
const t = useTranslations(lang);

const { title, description = DATA.ogDescription, image } = Astro.props;

const pageTitle = title
  ? CONFIG.seo.titleTemplate.replace("%s", title).replace("%n", DATA.name)
  : t.seo.homeTitle;
const ogImage = image
  ? image.startsWith("http")
    ? image
    : `${CONFIG.site.url}${image}`
  : `${CONFIG.site.url}${DATA.ogImage}`;

const { light, dark, radius } = CONFIG.theme;
const { baseFontSize } = CONFIG.typography;

const currentPath = Astro.url.pathname;

// Liens par locale pour la page courante (hreflang + sélecteur de langue).
const basePath = stripLangPrefix(currentPath);
// Canonical normalisé par défaut (slash final), surclassable par la page.
const canonicalURL = Astro.props.canonicalURL ?? localeUrl(basePath, lang, CONFIG.site.url);
const allLangs = Object.keys(languages) as Lang[];
const langLinks = allLangs.map((l) => ({
  code: l,
  label: languages[l],
  href: localizeHref(basePath, l),
  current: l === lang,
}));
---

<html
  lang={t.htmlLang}
  style={`font-size: ${baseFontSize}%;`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preconnect pour les ressources externes critiques -->
    <link rel="preconnect" href="https://cloud.umami.is" crossorigin />

    <!-- FOUC prevention: apply stored theme before first paint -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem("theme");
          if (
            theme === "dark" ||
            (!theme &&
              window.matchMedia("(prefers-color-scheme: dark)").matches)
          ) {
            document.documentElement.classList.add("dark");
          } else {
            document.documentElement.classList.remove("dark");
          }
        } catch (_) {}
      })();
    </script>

    <!-- Theme variables from config.ts -->
    <style
      set:html={`
      :root {
        --radius: ${radius};
        --background: ${light.background};
        --foreground: ${light.foreground};
        --card: ${light.card};
        --card-foreground: ${light.cardForeground};
        --popover: ${light.popover};
        --popover-foreground: ${light.popoverForeground};
        --primary: ${light.primary};
        --primary-foreground: ${light.primaryForeground};
        --secondary: ${light.secondary};
        --secondary-foreground: ${light.secondaryForeground};
        --muted: ${light.muted};
        --muted-foreground: ${light.mutedForeground};
        --accent: ${light.accent};
        --accent-foreground: ${light.accentForeground};
        --destructive: ${light.destructive};
        --border: ${light.border};
        --input: ${light.input};
        --ring: ${light.ring};
      }
      .dark {
        --background: ${dark.background};
        --foreground: ${dark.foreground};
        --card: ${dark.card};
        --card-foreground: ${dark.cardForeground};
        --popover: ${dark.popover};
        --popover-foreground: ${dark.popoverForeground};
        --primary: ${dark.primary};
        --primary-foreground: ${dark.primaryForeground};
        --secondary: ${dark.secondary};
        --secondary-foreground: ${dark.secondaryForeground};
        --muted: ${dark.muted};
        --muted-foreground: ${dark.mutedForeground};
        --accent: ${dark.accent};
        --accent-foreground: ${dark.accentForeground};
        --destructive: ${dark.destructive};
        --border: ${dark.border};
        --input: ${dark.input};
        --ring: ${dark.ring};
      }
    `}
    ></style>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Primary meta -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang: une version par locale + x-default (FR) -->
    {allLangs.map((l) => (
      <link rel="alternate" hreflang={l} href={localeUrl(basePath, l, CONFIG.site.url)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={localeUrl(basePath, defaultLang, CONFIG.site.url)} />

    <!-- Robots -->
    <meta name="robots" content={CONFIG.seo.robots} />
    <meta
      name="googlebot"
      content="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"
    />
    <meta name="copyright" content={`© ${year} ${DATA.name}`} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={DATA.name} />
    <meta property="og:locale" content={localeOg[lang]} />
    {allLangs.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={localeOg[l]} />
    ))}
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content={CONFIG.seo.twitterCard} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Umami Analytics -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="5c301f8e-8642-4e8b-b7f1-d8d9cb422c14"></script>
  </head>
  <body class="min-h-screen bg-background font-sans antialiased relative">

    <!-- DiagonalGrid — optimisé dirty-rect, 20fps max -->
    <div class="absolute inset-0 h-[30vh] overflow-hidden z-0 pointer-events-none">
      <DiagonalGrid
        client:idle
        className="h-full w-full"
        lineSize={8}
        gridGap={12}
        color="var(--foreground)"
        flickerChance={0.3}
        maxOpacity={0.45}
        style={{
          maskImage: "linear-gradient(to bottom, black 30%, transparent 100%)",
          WebkitMaskImage: "linear-gradient(to bottom, black 30%, transparent 100%)",
        }}
      />
    </div>

    <!-- Navigation flottante — pills indépendantes sur l'animation, sans barre de fond -->
    <nav class="fixed top-0 inset-x-0 z-30 pointer-events-none">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 pt-4 flex items-center justify-between">

        <!-- Logo "nota" — retour à l'accueil -->
        <a
          href={localizeHref("/", lang)}
          class="text-sm font-semibold tracking-tight pointer-events-auto
                 bg-background/80 backdrop-blur-sm text-foreground hover:text-foreground/70 transition-colors
                 px-3 py-1.5 rounded-full border border-border/40"
        >
          nota
        </a>

        <!-- Liens de navigation — pills droite -->
        <div class="flex items-center gap-1 sm:gap-1.5 pointer-events-auto">

          <!-- Desktop : pills de navigation + sélecteur de langue -->
          <div class="hidden items-center gap-1 sm:gap-1.5 md:flex">
            {DATA.navbar.map((item) => (
              <a
                href={item.href}
                aria-current={currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href)) ? "page" : undefined}
                class={`text-xs sm:text-sm px-2.5 sm:px-3 py-1.5 rounded-full border border-border/40
                        bg-background/80 backdrop-blur-sm transition-colors
                        ${
                          currentPath === item.href ||
                          (item.href !== "/" && currentPath.startsWith(item.href))
                            ? "text-foreground font-medium"
                            : "text-muted-foreground hover:text-foreground"
                        }`}
              >
                {item.label}
              </a>
            ))}

            <a
              href="https://calendly.com/stephanepadrao/30min"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs sm:text-sm px-2.5 sm:px-3 py-1.5 rounded-full border border-primary/40
                     bg-primary/10 text-primary hover:bg-primary hover:text-primary-foreground transition-colors font-medium flex items-center gap-1.5"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
              {t.nav.bookCall}
            </a>

            <details class="relative pointer-events-auto" id="lang-switch">
              <summary
                aria-label={t.langSwitch.label}
                class="size-8 flex items-center justify-center rounded-full text-xs font-semibold
                       bg-background/80 backdrop-blur-sm border border-border/40
                       text-muted-foreground hover:text-foreground transition-colors cursor-pointer
                       list-none [&::-webkit-details-marker]:hidden"
              >
                {lang.toUpperCase()}
              </summary>
              <div class="absolute right-0 mt-1.5 w-36 rounded-xl border border-border/40 bg-background/95 backdrop-blur-sm shadow-lg overflow-hidden z-50">
                {langLinks.map((l) => (
                  <a
                    href={l.href}
                    hreflang={l.code}
                    class={`block px-3 py-1.5 text-xs transition-colors ${
                      l.current
                        ? "bg-accent text-foreground font-medium"
                        : "text-muted-foreground hover:bg-accent hover:text-foreground"
                    }`}
                  >
                    {l.label}
                  </a>
                ))}
              </div>
            </details>
          </div>

          <!-- Toggle dark/light — toujours visible -->
          <button
            id="theme-toggle"
            aria-label={t.nav.themeToggle}
            class="size-8 flex items-center justify-center rounded-full
                   bg-background/80 backdrop-blur-sm border border-border/40
                   text-muted-foreground hover:text-foreground transition-colors cursor-pointer
                   pointer-events-auto"
          >
            <!-- Moon: affiché en mode clair -->
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
            </svg>
            <!-- Sun: affiché en mode sombre -->
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block">
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
            </svg>
          </button>

          <!-- Mobile : menu hamburger (liens + langues) -->
          <details class="relative pointer-events-auto md:hidden" id="mobile-menu">
            <summary
              aria-label="Menu"
              class="size-8 flex items-center justify-center rounded-full
                     bg-background/80 backdrop-blur-sm border border-border/40
                     text-muted-foreground hover:text-foreground transition-colors cursor-pointer
                     list-none [&::-webkit-details-marker]:hidden"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            </summary>
            <div class="absolute right-0 mt-1.5 w-52 rounded-xl border border-border/40 bg-background/95 backdrop-blur-sm shadow-lg overflow-hidden z-50">
              <a
                href="https://calendly.com/stephanepadrao/30min"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 px-4 py-2 text-sm text-primary font-medium hover:bg-accent transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                {t.nav.bookCall}
              </a>
              {DATA.navbar.map((item) => (
                <a
                  href={item.href}
                  aria-current={currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href)) ? "page" : undefined}
                  class={`block px-4 py-2 text-sm transition-colors ${
                    currentPath === item.href ||
                    (item.href !== "/" && currentPath.startsWith(item.href))
                      ? "bg-accent text-foreground font-medium"
                      : "text-muted-foreground hover:bg-accent hover:text-foreground"
                  }`}
                >
                  {item.label}
                </a>
              ))}
              <div class="my-1 border-t border-border/40"></div>
              <div class="flex items-center gap-1.5 px-4 py-2">
                {langLinks.map((l) => (
                  <a
                    href={l.href}
                    hreflang={l.code}
                    class={`rounded-md border border-border/40 px-2 py-0.5 text-xs font-medium transition-colors ${
                      l.current ? "bg-accent text-foreground" : "text-muted-foreground hover:text-foreground"
                    }`}
                  >
                    {l.code.toUpperCase()}
                  </a>
                ))}
              </div>
            </div>
          </details>
        </div>
      </div>
    </nav>

    <!-- Contenu principal — padding-top pour ne pas passer sous la nav fixe -->
    <div class="relative z-10 max-w-7xl mx-auto pt-16 pb-12 sm:pt-20 sm:pb-12 px-4 sm:px-6 lg:px-10">
      <slot />
    </div>

    <!-- Footer — copyright global -->
    <footer class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-10 pb-10">
      <p class="text-center text-xs text-muted-foreground">
        © {year} {DATA.name}. {t.footer.rights}
      </p>
    </footer>

    <!-- Lightbox global (images data-zoom) -->
    <Lightbox lang={lang} />

    <!-- Theme toggle — vanilla JS, pas de React -->
    <script is:inline>
      document.getElementById("theme-toggle").addEventListener("click", function () {
        var isDark = document.documentElement.classList.toggle("dark");
        try { localStorage.setItem("theme", isDark ? "dark" : "light"); } catch (_) {}
      });
      // Ferme les menus déroulants (langue, mobile) au clic extérieur.
      document.addEventListener("click", function (e) {
        ["lang-switch", "mobile-menu"].forEach(function (id) {
          var d = document.getElementById(id);
          if (d && d.open && !d.contains(e.target)) d.removeAttribute("open");
        });
      });
    </script>
  </body>
</html>
